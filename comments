CREATE TABLE comments (
    comment_id SERIAL PRIMARY KEY,
    review_id INT REFERENCES reviews(review_id),
    user_id INT REFERENCES users(user_id),
    comment_text TEXT,
    comment_date TIMESTAMP
);

