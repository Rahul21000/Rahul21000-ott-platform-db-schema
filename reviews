CREATE TABLE reviews (
    review_id SERIAL PRIMARY KEY,
    user_id INT REFERENCES users(user_id),
    movie_id INT REFERENCES movies(movie_id),
    rating DECIMAL(2,1),
    review_text TEXT,
    review_date DATE
);

